# =========================================================================
# CallGuard — secrets
#
# LOCAL:  save as  .streamlit/secrets.toml  next to app_web.py
# CLOUD:  paste the contents into
#         Streamlit Cloud -> your app -> Manage app -> Settings -> Secrets
#
# NEVER commit this file. `.streamlit/secrets.toml` is already in .gitignore.
# =========================================================================


# ---- Login --------------------------------------------------------------
# Anyone with this password sees every transcript, score and agent name.
# Make it long and random.
APP_PASSWORD = "change-me-to-something-long-and-random"


# =========================================================================
# TWO PROVIDERS
#
# CallGuard talks to two different APIs, and they are NOT interchangeable:
#
#   1. TRANSCRIPTION (speech -> text) needs a Whisper endpoint.
#   2. AUDIT (text -> QA score) needs a chat-completions endpoint.
#
# OpenRouter has NO transcription endpoint — it serves chat completions only.
# So the audio still has to be transcribed somewhere else (Groq hosts Whisper
# and has a free tier), and only the auditing LLM moves to OpenRouter.
# =========================================================================


# ---- 1. Transcription: Groq (Whisper) -----------------------------------
# https://console.groq.com/keys
TRANSCRIBE_API_KEY  = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TRANSCRIBE_BASE_URL = "https://api.groq.com/openai/v1"
TRANSCRIBE_MODEL    = "whisper-large-v3"


# ---- 2. Audit: OpenRouter (Qwen3 235B A22B) -----------------------------
# https://openrouter.ai/settings/keys
AUDIT_API_KEY  = "sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AUDIT_BASE_URL = "https://openrouter.ai/api/v1"
AUDIT_MODEL    = "qwen/qwen3-235b-a22b"

# Optional. Sets the OpenRouter HTTP-Referer header, which puts your app on
# the OpenRouter leaderboards. Use your deployed Streamlit URL.
# CALLGUARD_APP_URL = "https://call-gaurd.streamlit.app"


# =========================================================================
# OPTIONAL — delete any line to use the default shown
# =========================================================================

# Where the SQLite database and audio_store folder live. Default "." is next
# to app_web.py, which Streamlit Community Cloud WIPES on every redeploy.
# CALLGUARD_DATA_DIR = "/mnt/data"

# Largest audio file accepted, in MB. Bigger files are skipped with a note
# rather than failing mid-batch. Groq's Whisper limit is 25 MB on the free
# tier, 100 MB on dev. Also raise server.maxUploadSize in config.toml.
# CALLGUARD_MAX_AUDIO_MB = "25"

# Files transcribed + audited at once. Defaults to 2 on OpenRouter, 4
# elsewhere. OpenRouter caps how much spend can be IN FLIGHT at once (not just
# your balance), so parallel requests to a big model can return
# "402 in_flight_budget_exhausted" even with credit remaining. If you hit that,
# set this to "1" — the batch takes longer but stops failing.
# CALLGUARD_WORKERS = "2"

# Ceiling on the audit model's reply. The JSON we want is ~500 tokens; the cap
# stops a degenerate generation running to the model's full 8K output limit.
# Raise it only if you see "response hit the token cap" in the audit log.
# CALLGUARD_AUDIT_MAX_TOKENS = "2048"

# Characters of transcript sent to the audit model. Qwen3 235B A22B is 32K
# context by default, so a very long call could overflow it and fail. The
# FULL transcript is always stored in the database; only the copy sent to the
# auditor is trimmed, and the audit log says when that happened.
# CALLGUARD_MAX_TRANSCRIPT_CHARS = "48000"


# =========================================================================
# BACKWARD COMPATIBILITY
#
# The old single-provider names still work as fallbacks, so an existing
# deployment keeps running if you only set these:
#
#   GROQ_API_KEY          -> used for BOTH providers if the new keys are unset
#   GROQ_BASE_URL         -> falls back for TRANSCRIBE_BASE_URL
#   GROQ_TRANSCRIBE_MODEL -> falls back for TRANSCRIBE_MODEL
#   GROQ_AUDIT_MODEL      -> falls back for AUDIT_MODEL
#   OPENROUTER_API_KEY    -> falls back for AUDIT_API_KEY
#
# Precedence is always: the specific name first, then the fallback.
# Settings -> About shows exactly what resolved, and checks each model
# against what its key can actually reach.
# =========================================================================
